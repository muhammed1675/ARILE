# =====================================================================
# ARÍLÉ — environment variables
# Copy this file to `.env` and fill in your own values.
# Only VITE_* variables reach the browser. Never put secret keys here.
# =====================================================================

# ---- Supabase (browser) ---------------------------------------------
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key


# =====================================================================
# The values below are NOT used by the frontend.
# Set them as Supabase Edge Function secrets instead:
#   supabase secrets set KEY=value
# They are listed here only so you have everything in one place.
# =====================================================================

# ---- Korapay (server only) ------------------------------------------
# Dashboard → Settings → API Keys & Webhooks
# KORAPAY_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# ---- Resend (server only) -------------------------------------------
# resend.com → API Keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# ORDER_EMAIL_FROM=ARÍLÉ <orders@yourdomain.com>
# ORDER_EMAIL_TO=studio@yourdomain.com

# ---- Where the site is hosted (server only) -------------------------
# Used to build the Korapay redirect URL after payment.
# SITE_URL=https://arile.ng
